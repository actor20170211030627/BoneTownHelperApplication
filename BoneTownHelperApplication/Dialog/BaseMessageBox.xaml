<Window x:Class="BoneTownHelperApplication.Dialog.BaseMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:BoneTownHelperApplication.Dialog"
        mc:Ignorable="d"
        Title="BaseMessageBox" Height="Auto" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        MinWidth="320" MinHeight="100" MaxWidth="500"
        WindowStyle="SingleBorderWindow"
        FontFamily="Segoe UI" FontSize="13"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
    
    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 第一行：图标 + 消息 -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 图标控件（支持 ImageSource 或 内置矢量） -->
            <Image x:Name="IconImage" Grid.Column="0" 
                   Width="32" Height="32" Margin="0,0,16,0"
                   VerticalAlignment="Top" HorizontalAlignment="Left"
                   Visibility="Collapsed"/>

            <!-- 消息文本 -->
            <TextBlock Grid.Column="1" x:Name="MessageText" 
                       TextWrapping="Wrap" 
                       VerticalAlignment="Center"
                       Text="Message"
                       Margin="0,0,0,0"/>
        </Grid>

        <!-- 第二行：按钮区域 -->
        <StackPanel Grid.Row="1" x:Name="ButtonsPanel" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right" 
                    Margin="0,24,0,0" />
    </Grid>
</Window>
